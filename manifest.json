{
  "manifest_version": 3,
  "name": "Ad Volume Controller",
  "version": "1.0.0",
  "description": "Automatically mutes YouTube ads and attempts to skip them when possible.",
  "permissions": ["debugger"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Ad Volume Controller"
  }
}